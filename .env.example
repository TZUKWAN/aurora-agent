# Aurora Agent - Environment Variables
# Copy this file to .env and fill in your values

# LLM API Configuration (required)
AURORA_API_KEY=your_api_key_here
AURORA_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AURORA_MODEL=glm-4.7-flash

# Model profile shortcut (optional, overrides individual vars above)
# AURORA_PROFILE=glm

# Available profiles: glm, deepseek, deepseek-v3, qwen
# Each profile uses AURORA_API_KEY for auth
